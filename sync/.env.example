# Kopiere diese Datei zu ".env" (im selben Ordner) und trag dort deine echten
# Zugangsdaten ein. Die ".env" wird von git nie mit hochgeladen (siehe .gitignore)
# und bleibt nur lokal auf diesem PC.

# --- Garmin Connect ---
GARMIN_EMAIL=
GARMIN_PASSWORD=

# --- Renpho (Waage) ---
RENPHO_EMAIL=
RENPHO_PASSWORD=
